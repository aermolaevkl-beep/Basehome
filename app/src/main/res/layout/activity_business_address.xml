<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <!-- Header with Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBackBusiness"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Юр. адреса"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnAddBusinessAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Добавить юр. адрес"
        android:backgroundTint="#FF9800" />

    <EditText
        android:id="@+id/etSearchBusiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Поиск (улица, ТЦ...)"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background" />

    <TextView
        android:id="@+id/tvSectionTitleBusiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="Последние записи:"
        android:textStyle="bold"
        android:textColor="#666666" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBusinessAddresses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvNoResultsBusiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ничего не найдено"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnViewMoreBusiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Показать еще 5"
        android:backgroundTint="#FF9800" />

</LinearLayout>