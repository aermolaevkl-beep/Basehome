<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <EditText
        android:id="@+id/etEntranceNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Номер подъезда"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etIntercomCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Код домофона"
        android:inputType="textCapSentences"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etCrossFloor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Этаж кросса"
        android:inputType="textCapSentences"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etBasementKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ключ от подвала"
        android:inputType="textCapSentences"
        android:padding="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

</LinearLayout>