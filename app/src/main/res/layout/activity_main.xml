<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <!-- Header Section with Profile and Logout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРОФИЛЬ"
                android:backgroundTint="#9C27B0"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#D32F2F"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp">

                <ImageButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:background="?android:attr/selectableItemBackground"
                    app:tint="@android:color/white"
                    android:scaleType="centerInside"
                    android:contentDescription="Выйти" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Выберите раздел:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnPhysicalSection"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Физ. адреса"
        android:textSize="18sp"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnBusinessSection"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Юр. адреса"
        android:textSize="18sp"
        android:backgroundTint="#FF9800" />

</LinearLayout>