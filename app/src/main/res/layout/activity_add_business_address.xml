<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавление Юр. адреса"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите город:"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"/>

    <Spinner
        android:id="@+id/spinnerBusinessCity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@android:drawable/btn_dropdown"
        android:spinnerMode="dropdown" />

    <EditText
        android:id="@+id/etBusinessStreet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Улица"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@android:drawable/editbox_background"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/etBusinessHouse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Номер дома"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@android:drawable/editbox_background"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/etCenterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название ТЦ, БЦ"
        android:padding="14dp"
        android:layout_marginBottom="24dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:background="@android:drawable/editbox_background"
        android:inputType="textCapSentences" />

    <Button
        android:id="@+id/btnSaveBusiness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить"
        android:backgroundTint="#FF9800"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:textStyle="bold" />

</LinearLayout>